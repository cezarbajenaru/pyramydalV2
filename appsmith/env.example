# Appsmith Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ============================================
# ENCRYPTION (CRITICAL - GENERATE ONCE!)
# ============================================
# Generate with: openssl rand -base64 32
# NEVER change these after first setup!

APPSMITH_ENCRYPTION_PASSWORD=GENERATE_RANDOM_STRING_32_CHARS
APPSMITH_ENCRYPTION_SALT=GENERATE_RANDOM_STRING_32_CHARS

# ============================================
# DATABASE CONNECTION
# ============================================
PYRAMYDAL_DB_HOST=your-rds-endpoint.eu-central-1.rds.amazonaws.com
PYRAMYDAL_DB_NAME=production
PYRAMYDAL_DB_USER=admin
PYRAMYDAL_DB_PASSWORD=your-db-password

# ============================================
# S3 BUCKET
# ============================================
PYRAMYDAL_S3_BUCKET=pyramydal-prod-files

# ============================================
# OPTIONAL: EMAIL CONFIGURATION
# ============================================
# APPSMITH_MAIL_ENABLED=true
# APPSMITH_MAIL_FROM=noreply@yourcompany.com
# APPSMITH_MAIL_HOST=smtp.gmail.com
# APPSMITH_MAIL_PORT=587
# APPSMITH_MAIL_USERNAME=your-email@gmail.com
# APPSMITH_MAIL_PASSWORD=your-app-password

# ============================================
# OPTIONAL: SSO (Google OAuth)
# ============================================
# APPSMITH_OAUTH2_GOOGLE_CLIENT_ID=your-client-id
# APPSMITH_OAUTH2_GOOGLE_CLIENT_SECRET=your-client-secret

